# PostgreSQL
POSTGRES_USER=ainerwise
POSTGRES_PASSWORD=ainerwise_dev_2024
POSTGRES_DB=ainerwise
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ainerwise_redis_dev

# Shared platform — Cebu legacy DB (SP02, same postgres cluster)
CEBU_LEGACY_DB_PASSWORD=cebu_legacy_dev

# SP03 — Legacy API bridge (separate from SERVICE_TOKEN / user JWT)
LEGACY_BRIDGE_CLIENT_ID=cebu-legacy
LEGACY_BRIDGE_SECRET=cebu_legacy_bridge_dev_change_me
LEGACY_BRIDGE_MAX_SKEW_SECONDS=300

# MinIO
MINIO_ROOT_USER=ainerwise
MINIO_ROOT_PASSWORD=ainerwise_minio_dev
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# Procurement — local dev fallback when API is called without nginx (e.g. tests)
PROCUREMENT_DEFAULT_PORTAL_KEY=aislos

# Demo mode (Admin → Settings can override in DB; env is first-boot default)
DEMO_MODE_ENABLED=false

# Backend
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:4097","http://localhost:4098","http://localhost:4099","http://127.0.0.1:4097","http://127.0.0.1:4098","http://127.0.0.1:4099","http://localhost:8000","http://localhost"]
API_V1_PREFIX=/api/v1

# Frontend
# Direct backend (tests/CI). Browser on :4099 rewrites to nginx /api/v1 via useApiBase.
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# Cebu portal (recommended with docker compose nginx):
#   UI  http://cebu.localhost/cebu
#   API http://cebu.localhost/api/v1  (X-Portal-Key injected by nginx)

# Telegram (Phase 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
EMAIL_WEBHOOK_SECRET=

# AI Orchestrator
# LLM/embedding credentials are configured in Admin -> Settings -> Integrations (AI),
# not via env. These two secure service-to-service calls and the restricted DB role.
AI_ORCHESTRATOR_URL=http://ai-orchestrator:8001
CHANNEL_GATEWAY_URL=http://channel-gateway:8200
BACKEND_INTERNAL_URL=http://backend:8000/internal/v1
PARTNER_PORTAL_URL=http://localhost:4098
SERVICE_TOKEN=ainerwise_service_dev
ORCHESTRATOR_DB_PASSWORD=ainerwise_orchestrator_dev
# Public H5 URL used in one-time password reset emails.
PASSWORD_RESET_BASE_URL=http://localhost:4098/auth/reset-password
BACKUP_DIR=/app/backups
UPLOAD_DIR=/app/uploads
